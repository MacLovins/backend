GOOGLE_API_KEY=YOUR_API_KEY

POSTGRES_DB=leadradar
POSTGRES_USER=leadradar
POSTGRES_PASSWORD=leadradar
POSTGRES_PORT=5432
REDIS_PORT=6379

PARSER_ADAPTERS=gdelt,website,jobs_ats,careers_html,wikidata
PARSER_USER_AGENT=LeadRadarBot/0.1 (+https://example.com/bot; team@example.com)
PARSER_CACHE_DIR=.cache/parser
PARSER_CACHE_TTL_S=86400
PARSER_HOST_RPS=1
PARSER_MAX_CONCURRENCY=8

# --- ai: Gemini gateway (GEMINI_API_KEY works too) ---
# Model order = fallback order. Check availability and limits in AI Studio → Rate limits.
LLM_MAIN_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash
LLM_CHEAP_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# EXAMPLE values — replace with the real per-project limits
LLM_LIMITS_JSON={"gemini-3.8-flash":{"rpm":10,"rpd":250},"gemini-3.5-flash-lite":{"rpm":15,"rpd":1000}}
LLM_TIMEOUT_S=90
LLM_MAX_INPUT_TOKENS=30000
LLM_CACHE_ENABLED=true
AI_EMBED_MODEL=intfloat/multilingual-e5-small
AI_TOPK_PER_QUESTION=5
AI_MAX_SNIPPETS_PER_SERVICE=40
AI_EMBED_CACHE_DIR=.cache/fastembed
