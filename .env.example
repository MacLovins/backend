PYTHONPATH=backend/backend/src:backend/auth/src:backend/ai/src:parser/src

# App / Core
APP_ENV=dev
APP_PUBLIC_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql+asyncpg://leadradar:leadradar@localhost:5432/leadradar
LANGGRAPH_DB_URL=postgresql://leadradar:leadradar@localhost:5432/leadradar
REDIS_URL=redis://localhost:6379/0
WORKER_MAX_ASYNC_TASKS=3
REFRESH_CRON="0 */6 * * *"

# Auth
AUTH_JWT_SECRET=leadradar-super-secret-development-jwt-key-32chars!
AUTH_JWT_ALG=HS256
AUTH_ACCESS_TTL_MIN=720
AUTH_COOKIE_NAME=lr_session
AUTH_COOKIE_SECURE=false
AUTH_ISSUER=leadradar
AUTH_AUDIENCE=leadradar-web
AUTH_DEFAULT_ORG_ID=00000000-0000-0000-0000-000000000001

# AI / LLM
GOOGLE_API_KEY=YOUR_GEMINI_API_KEY
LLM_MODEL_MAIN=gemini-2.5-flash
LLM_MODEL_CHEAP=gemini-2.5-flash-lite

# Feature flags & Integrations
FEATURE_OUTREACH=false
FEATURE_ALERTS=false
FEATURE_HUBSPOT=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
HUBSPOT_PRIVATE_APP_TOKEN=
