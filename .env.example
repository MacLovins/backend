# Copy to .env and adjust. Never commit real secrets.
# Each package reads only its own prefix: core → APP_*, auth → AUTH_*, parser → PARSER_*, ai → LLM_* / AI_*.
# A variable without the right prefix is silently ignored.

# --- core (leadradar_core/settings.py, prefix APP_) ---
# dev | test | demo (anything but dev/test requires a real AUTH_JWT_SECRET)
APP_ENV=dev
# allowed Origin for cookie-authenticated writes, CORS
APP_PUBLIC_ORIGIN=http://localhost:3000
APP_DATABASE_URL=postgresql+asyncpg://leadradar:leadradar@localhost:5432/leadradar
# empty = derived from APP_DATABASE_URL
APP_LANGGRAPH_DB_URL=postgresql://leadradar:leadradar@localhost:5432/leadradar
APP_REDIS_URL=redis://localhost:6379/0
APP_WORKER_MAX_ASYNC_TASKS=3
APP_REFRESH_CRON="0 */6 * * *"
APP_DISCOVERY_TIMEOUT_S=60
APP_FEATURE_OUTREACH=true
APP_FEATURE_ALERTS=false
APP_FEATURE_HUBSPOT=false
APP_TELEGRAM_BOT_TOKEN=
APP_TELEGRAM_CHAT_ID=
APP_HUBSPOT_PRIVATE_APP_TOKEN=

# --- Postgres / Redis containers (docker compose) ---
POSTGRES_DB=leadradar
POSTGRES_USER=leadradar
POSTGRES_PASSWORD=leadradar
POSTGRES_PORT=5432
REDIS_PORT=6379
# cloudflared named tunnel (demo server)
CF_TUNNEL_TOKEN=

# --- auth (leadradar_auth/settings.py, prefix AUTH_) ---
# Required outside dev: a random value of at least 32 characters, e.g. `openssl rand -hex 32`.
# The app refuses to start with this placeholder when APP_ENV is not dev/test.
AUTH_JWT_SECRET=change-me-to-a-random-secret-of-at-least-32-chars
AUTH_JWT_ALG=HS256
AUTH_ACCESS_TTL_MIN=720
AUTH_COOKIE_NAME=lr_session
# Unset = true outside dev/test, false in dev (plain http://localhost). Set explicitly only to override.
# AUTH_COOKIE_SECURE=true
AUTH_ISSUER=leadradar
AUTH_AUDIENCE=leadradar-web
AUTH_DEFAULT_ORG_ID=00000000-0000-0000-0000-000000000001
# login attempts per IP + e-mail ...
AUTH_LOGIN_RATE_LIMIT=5
# ... per this window → 429
AUTH_LOGIN_RATE_WINDOW_S=60

# --- parser (prefix PARSER_; source API keys are read under their own names) ---
PARSER_ADAPTERS=google_news,gdelt,newsapi,serpapi,website,jobs_ats,careers_html,wikidata
PARSER_USER_AGENT="LeadRadarBot/0.1 (+https://example.invalid/bot; engineering@example.invalid)"
PARSER_CACHE_DIR=.cache/parser
PARSER_CACHE_TTL_S=86400
PARSER_HOST_RPS=1
PARSER_MAX_CONCURRENCY=8
SERPAPI_KEY=
NEWSAPI_KEY=

# --- ai: LLM gateway (prefix LLM_ / AI_; the API key is read as GEMINI_API_KEY or GOOGLE_API_KEY) ---
# Model order = fallback order. Check availability and limits in AI Studio → Rate limits.
GOOGLE_API_KEY=
LLM_MAIN_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash
LLM_CHEAP_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# EXAMPLE values — replace with the real per-project limits (also shown by GET /api/v1/meta/usage)
LLM_LIMITS_JSON={"gemini-3.8-flash":{"rpm":10,"rpd":250},"gemini-3.5-flash-lite":{"rpm":15,"rpd":1000}}
LLM_TIMEOUT_S=90
LLM_MAX_INPUT_TOKENS=30000
LLM_CACHE_ENABLED=true
AI_EMBED_MODEL=intfloat/multilingual-e5-small
AI_TOPK_PER_QUESTION=5
AI_MAX_SNIPPETS_PER_SERVICE=40
AI_EMBED_CACHE_DIR=.cache/fastembed
