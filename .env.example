PYTHONPATH=core/src:auth/src:ai/src:parser/src

# App / Core
APP_ENV=dev
APP_PUBLIC_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql+asyncpg://leadradar:leadradar@localhost:5432/leadradar
LANGGRAPH_DB_URL=postgresql://leadradar:leadradar@localhost:5432/leadradar
REDIS_URL=redis://localhost:6379/0
WORKER_MAX_ASYNC_TASKS=3
REFRESH_CRON="0 */6 * * *"

# Postgres / Redis Docker settings
POSTGRES_DB=leadradar
POSTGRES_USER=leadradar
POSTGRES_PASSWORD=leadradar
POSTGRES_PORT=5432
REDIS_PORT=6379

# Auth
AUTH_JWT_SECRET=leadradar-super-secret-development-jwt-key-32chars!
AUTH_JWT_ALG=HS256
AUTH_ACCESS_TTL_MIN=720
AUTH_COOKIE_NAME=lr_session
AUTH_COOKIE_SECURE=false
AUTH_ISSUER=leadradar
AUTH_AUDIENCE=leadradar-web
AUTH_DEFAULT_ORG_ID=00000000-0000-0000-0000-000000000001

# Parser (P2 Data Layer: GDELT, Google News RSS, NewsAPI, SerpAPI, ATS, Wikidata, PDF reports, HIBP, GLEIF, Adzuna)
# Keyed adapters (newsapi, serpapi, rsshub, crunchbase, adzuna) stay disabled until their key is set.
PARSER_ADAPTERS=google_news,gdelt,newsapi,serpapi,website,jobs_ats,careers_html,wikidata,reports,hibp,gleif,adzuna
# Identifiable bot UA with contact (parser SPEC §1.7.1). Browser UAs get 429 from Wikidata and are tarpitted by Akamai
PARSER_USER_AGENT="LeadRadarBot/0.1 (+https://github.com/MacLovins/backend)"
PARSER_CACHE_DIR=.cache/parser
PARSER_CACHE_TTL_S=86400
PARSER_HOST_RPS=1
PARSER_MAX_CONCURRENCY=8
# PDF annual / strategy reports: PDFs per company, size cap per PDF, download deadline
PARSER_REPORTS_MAX_PDFS=3
PARSER_REPORTS_MAX_PDF_MB=30
PARSER_REPORTS_DOWNLOAD_TIMEOUT_S=60
SERPAPI_KEY=
NEWSAPI_KEY=
# Adzuna job search (free plan: 25 requests/min, 250/day), https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Optional: self-hosted RSSHub (the public rsshub.app blocks bots) and Crunchbase API licence.
# RSSHUB_ROUTE is a keyword-search route with {query}; /google/news/... takes a section title, not a search.
RSSHUB_BASE_URL=
RSSHUB_ROUTE=/bing/search/{query}
CRUNCHBASE_API_KEY=

# --- ai: Gemini / OpenAI / Anthropic gateway (GEMINI_API_KEY works too) ---
# Model order = fallback order. Check availability and limits in AI Studio → Rate limits.
GOOGLE_API_KEY=YOUR_GEMINI_API_KEY
LLM_MAIN_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash
LLM_CHEAP_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# EXAMPLE values — replace with the real per-project limits
LLM_LIMITS_JSON={"gemini-3.8-flash":{"rpm":10,"rpd":250},"gemini-3.5-flash-lite":{"rpm":15,"rpd":1000}}
LLM_TIMEOUT_S=90
LLM_MAX_INPUT_TOKENS=30000
LLM_CACHE_ENABLED=true
AI_EMBED_MODEL=intfloat/multilingual-e5-small
AI_TOPK_PER_QUESTION=5
AI_MAX_SNIPPETS_PER_SERVICE=40
AI_EMBED_CACHE_DIR=.cache/fastembed

# Feature flags & Integrations
FEATURE_OUTREACH=true
FEATURE_ALERTS=false
FEATURE_HUBSPOT=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
HUBSPOT_PRIVATE_APP_TOKEN=
CF_TUNNEL_TOKEN=
